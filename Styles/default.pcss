// + | header layout, wide screens: [ title | main menu | language + theme | connection ]
// fixed bar height and one font size (.75rem) for every element, whatever the screen size
$def['header'] = 'display:grid; grid-template-columns:minmax(0,max-content) minmax(0,1fr); align-items:center; column-gap:1.5rem; height:3.75rem; min-height:3.75rem; max-height:3.75rem; padding-top:0; padding-bottom:0; overflow:visible; font-size:.75rem; line-height:1;';
$def['header *'] = 'font-size:.75rem; line-height:1; box-sizing:border-box;';
$def['header > div:first-child'] = 'display:flex; align-items:center; gap:.6rem; min-width:0; max-width:30vw; overflow:hidden;';
$def['header img, header igk-img'] = 'width:2.5rem; height:2.5rem; flex:none;';
$def['header h2'] = 'margin:0; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex-shrink:1; letter-spacing:.12em;';
$def['header > nav'] = 'display:flex; align-items:center; min-width:0; height:100%;';
$def['header .menu-host'] = 'display:grid; grid-template-columns:minmax(0,1fr) max-content max-content; align-items:center; column-gap:.75rem; width:100%; min-width:0; height:100%;';
$def['header .fjd-burger'] = 'display:none;';
$def['header .menu-host ul'] = 'display:flex; flex-wrap:nowrap; align-items:center; justify-content:center; gap:.1rem; margin:0; padding:0; min-width:0; overflow:hidden;';
$def['header .menu li'] = 'flex:0 0 auto; white-space:nowrap;';
$def['header .menu li > a, header nav .menu li a, header nav.menu li > a'] = 'display:inline-block; padding:.5rem .6rem; letter-spacing:.1em; white-space:nowrap;';
$def['header .fjd-nav-prefs'] = 'display:flex; align-items:center; gap:.4rem; padding:0 .75rem; border-left:1px solid rgba(0,216,255,.25); border-right:1px solid rgba(0,216,255,.25); height:2rem;';
$def['header .fjd-nav-prefs select, header .fjd-nav-prefs button'] = 'height:2rem; padding:0 .5rem; margin:0; display:inline-flex; align-items:center;';
$def['header .fjd-nav-auth'] = 'display:flex; align-items:center; justify-content:flex-end; min-width:0; white-space:nowrap;';
