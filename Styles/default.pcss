// @variable
/**
 * @var mixed $css_m
 * @var mixed $def
 */
$def[':root']=[
    '--igk-link-visited-color'=> '#32760F',
    '--igk-link-color'=> '#4C9129',  
];
$def[$css_m.""] = "(:.google-Roboto) [bgcl:primary-bg-color] color: [cl:primary-color];"; 
$def[$css_m." iframe"] = "color: orangered; border:none;"; 
// + | selection color definition 
$def[$css_m." ::selection"] = "[fcl:selector-color,white] [bgcl:selection-bg-color, red]";
$key = $css_m.implode(','.$css_m, array_map(function($i){ return ' h'.$i;}, range(1,6)));
$def[$key] = "(:.primary-header-font)";
$def['.primary-header-font'] = 'font-family: arial, sans-serif';
// + | breadcrumb
$def['.igk-winui-breadcrumb'] = '{sys:dispib, no-wrap}';
$def['.igk-winui-breadcrumb li'] = '{sys:dispib,alignt} ';
$def['.igk-winui-breadcrumb li:not(:last-child):after'] = 'content: "/";padding:8px 5px;';
$def['footer'] = '{sys:loc_b fitw} margin-top: 2em;';
$def['a'] = 'color: var(--igk-link-color);';
$def['a:visited'] = ''; //color: var(--igk-link-color);';

$def['.dispflex.flex-row.alignr'] = 'justify-content: right;';
$def['nav.menu li > a'] = 'display:inline-block; padding: 10px;';
$def['textarea.height-3em'] = 'height:calc(3rem + 4em) !important;';
$def['nav .menu li a'] = 'padding: 10px 12px;';
$def['header .box'] = '{sys:posab}'; 
$def['header nav.menu-host'] = 'flex-grow:1; align-self:center;';
$def['.dispflex.alignm'] = 'align-items: center;';
$def['.dispflex.alignc'] = 'justify-content: center;';
$def['nav .menu svg'] = '{sys:dispb} margin:0 1em;';
// + | PRINTING
$PTR['body'] = 'height:auto;';
$PTR[$css_m.''] = 'height: auto; padding:10px; font-size: 8pt; width: 100%; position:relative;';
$PTR[$css_m.' a'] = 
$PTR[$css_m.' a:visited'] = 
'color: #888;';
$PTR[$css_m.' table'] = '{sys:fitw}';
$PTR[$css_m.' header nav'] = '{sys:dispn}';
$def['input[type=file]'] = '{sys:dispb} margin: 1.2em 0;';
$def['input[readonly], textarea[readonly]'] = 'background-color: #a8a2a2ff; border:1px solid #ddd;';

$def['.menu li > a'] = '{sys:no-wrap ellipsis}';

// $def['.fbj-edit-tabcontrol .igk-btn'] = 'border:initial; border-radius:initial;';
$def['.igk-btn'] = 'border-width: 0px; border-radius: 0;';


$def['.fs-\[8pt\]'] = 'font-size: 12pt;';
// + | landing page (Views/default.phtml). colors derive from currentColor to follow dark/light themes
$def['.fjd-home'] = 'padding: 2rem 1rem 3rem;';
$def['.fjd-wrap'] = 'max-width: 1080px; margin: 0 auto;';
$def['.fjd-hero'] = 'padding: 2.5rem 0 1.5rem;';
$def['.fjd-hero h1'] = 'font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; margin: 0 0 .75rem;';
$def['.fjd-eyebrow'] = 'text-transform: uppercase; letter-spacing: .12em; font-size: .75rem; font-weight: 600; color: var(--igk-link-color); margin: 0 0 .5rem;';
$def['.fjd-lead'] = 'font-size: 1.1rem; max-width: 40rem; opacity: .75; margin: 0 0 1.5rem;';
$def['.fjd-cta'] = 'display: flex; flex-wrap: wrap; gap: .75rem;';
$def['.fjd-btn'] = 'display: inline-block; padding: .6rem 1.1rem; border-radius: .6rem; text-decoration: none; font-weight: 600; color: inherit; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); transition: background .15s, transform .15s;';
$def['.fjd-btn:hover'] = 'background: color-mix(in srgb, currentColor 10%, transparent);';
$def['.fjd-btn-primary, .fjd-btn-primary:visited'] = 'background: var(--igk-link-color); border-color: var(--igk-link-color); color: #fff;';
$def['.fjd-btn-primary:hover'] = 'background: var(--igk-link-color); filter: brightness(1.1);';
$def['.fjd-btn-small'] = 'padding: .35rem .75rem; font-size: .85rem; margin-top: auto; align-self: flex-start;';
$def['.fjd-stats'] = 'display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin: 1rem 0 2rem;';
$def['.fjd-stat'] = 'display: flex; flex-direction: column; padding: 1rem 1.25rem; border-radius: .9rem; background: color-mix(in srgb, currentColor 6%, transparent); border: 1px solid color-mix(in srgb, currentColor 12%, transparent);';
$def['.fjd-stat-value'] = 'font-size: 2rem; font-weight: 700; line-height: 1.1;';
$def['.fjd-stat-label'] = 'font-size: .85rem; opacity: .7;';
$def['.fjd-block'] = 'margin: 2.5rem 0;';
$def['.fjd-block h2'] = 'font-size: 1.3rem; margin: 0 0 .5rem; padding-bottom: .4rem; border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);';
$def['.fjd-muted'] = 'opacity: .7; margin: 0 0 .75rem; font-size: .95rem;';
$def['.fjd-grid'] = 'display: grid; gap: 1rem; margin-top: 1rem;';
$def['.fjd-grid-menu'] = 'grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));';
$def['.fjd-grid-interims'] = 'grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));';
$def['.fjd-grid-tools'] = 'grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));';
$def['.fjd-card'] = 'display: flex; flex-direction: column; gap: .5rem; padding: 1rem 1.1rem; border-radius: .9rem; text-decoration: none; color: inherit; background: color-mix(in srgb, currentColor 5%, transparent); border: 1px solid color-mix(in srgb, currentColor 12%, transparent); transition: transform .15s, border-color .15s;';
$def['.fjd-card-link:hover'] = 'transform: translateY(-2px); border-color: var(--igk-link-color);';
$def['.fjd-card-title'] = 'font-size: 1rem; font-weight: 600; margin: 0; text-transform: capitalize;';
$def['.fjd-icon'] = 'font-size: 1.5rem; line-height: 1;';
$def['.fjd-interim'] = 'flex-direction: row; align-items: center; gap: .75rem;';
$def['.fjd-interim img'] = 'width: 32px; height: 32px; object-fit: contain; border-radius: .4rem; flex: none;';
$def['.fjd-chips'] = 'display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem;';
$def['.fjd-chip'] = 'padding: .35rem .85rem; border-radius: 999px; text-decoration: none; color: inherit; font-size: .9rem; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); transition: background .15s, border-color .15s;';
$def['.fjd-chip:hover'] = 'border-color: var(--igk-link-color); background: color-mix(in srgb, var(--igk-link-color) 15%, transparent);';

// + | header: let the menu wrap instead of overflowing horizontally
$def['header.dispflex'] = 'flex-wrap: wrap; row-gap: .5rem;';
$def['header > nav'] = 'flex: 1 1 0; min-width: 0; flex-wrap: wrap; justify-content: flex-end;';
$def['header nav.menu-host, header .menu-host'] = 'min-width: 0; flex: 1 1 0;';
$def['header ul.menu, header .dispflex.flex-row.alignr'] = 'flex-wrap: wrap; justify-content: flex-end; min-width: 0;';
$def['header .menu li > a'] = 'white-space: nowrap;';
