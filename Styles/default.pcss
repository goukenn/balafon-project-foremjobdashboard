// + | header: futuristic, full width
$def['header'] = 'top:0; z-index:50; width:100%; box-sizing:border-box; margin:0; padding:.6rem clamp(1rem, 3vw, 2.5rem); align-items:center; background:linear-gradient(135deg, rgba(8,14,32,.92), rgba(18,28,64,.88)); backdrop-filter:blur(14px) saturate(160%); border-bottom:1px solid rgba(0,200,255,.35); box-shadow:0 0 24px rgba(0,160,255,.18), inset 0 -1px 0 rgba(255,255,255,.05); color:#dbe7ff;';
$def['header:after'] = 'content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:linear-gradient(90deg, transparent, #00d8ff, #7a5cff, #ff3cac, transparent); opacity:.85; pointer-events:none;';
$def['header img, header igk-img'] = 'border-radius:12px; box-shadow:0 0 0 1px rgba(0,216,255,.5), 0 0 14px rgba(0,216,255,.45); width:44px; height:44px; object-fit:cover;';
$def['header h2'] = 'margin:0; font-family:"Orbitron","Rajdhani","Segoe UI",system-ui,sans-serif; font-size:1.05rem; font-weight:600; letter-spacing:.14em; text-transform:uppercase; background:linear-gradient(90deg, #00d8ff, #a58bff); -webkit-background-clip:text; background-clip:text; color:transparent; text-shadow:0 0 18px rgba(0,216,255,.35);';
$def['header ul'] = 'list-style:none; margin:0; padding:0; gap:.25rem;';
$def['header .menu li > a, header nav .menu li a, header nav.menu li > a'] = 'position:relative; font-size:.75rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; padding:.55rem .85rem; color:#b9c8ee; text-decoration:none; border-radius:.5rem; transition:color .2s, background .2s, box-shadow .2s;';
$def['header .menu li > a:after'] = 'content:""; position:absolute; left:.85rem; right:.85rem; bottom:.2rem; height:2px; background:linear-gradient(90deg,#00d8ff,#a58bff); transform:scaleX(0); transform-origin:left; transition:transform .25s;';
$def['header .menu li > a:hover'] = 'color:#fff; background:rgba(0,216,255,.1); box-shadow:0 0 14px rgba(0,216,255,.25);';
$def['header .menu li > a:hover:after'] = 'transform:scaleX(1);';
$def['header .fjd-lang select'] = 'background:rgba(0,216,255,.08); color:#dbe7ff; border:1px solid rgba(0,216,255,.4); border-radius:.5rem; font-size:.7rem; letter-spacing:.1em; padding:.35rem .55rem;';
$def['header .fjd-lang select:hover, header .fjd-lang select:focus'] = 'outline:none; box-shadow:0 0 12px rgba(0,216,255,.4);';
$def['header .igk-winui-toggle-theme'] = 'background:rgba(0,216,255,.1); border:1px solid rgba(0,216,255,.4); border-radius:.5rem; color:#dbe7ff; transition:box-shadow .2s;';
$def['header .igk-winui-toggle-theme:hover'] = 'box-shadow:0 0 14px rgba(0,216,255,.45);';
$def['.fjd-burger span'] = 'background:#00d8ff; box-shadow:0 0 6px rgba(0,216,255,.7);';
foreach ([&$xsm_screen, &$sm_screen, &$lg_screen] as &$_scr) {
    $_scr['header nav .menu-host'] = 'display:none; position:absolute; left:0; right:0; top:100%; z-index:20; flex:none; padding:.5rem clamp(1rem, 3vw, 2.5rem) 1rem; background:linear-gradient(180deg, rgba(8,14,32,.97), rgba(18,28,64,.97)); backdrop-filter:blur(14px); border-bottom:1px solid rgba(0,200,255,.35); box-shadow:0 12px 24px rgba(0,0,0,.4);';
