    $_scr['header nav .menu-host'] = 'display:none; position:absolute; left:0; right:0; top:100%; z-index:20; flex:none; padding:.5rem 1rem; background:var(--igk-bg-color, Canvas); border-bottom:1px solid rgba(128,128,128,.3); box-shadow:0 8px 16px rgba(0,0,0,.15);';
    $_scr['.fjd-menu-check:checked ~ .menu-host'] = 'display:block;';
