$def['header .fjd-nav-auth .box'] = 'max-width:16rem; white-space:nowrap;';
$def['header .fjd-user'] = 'display:flex; align-items:center; gap:.5rem; max-width:none;';
$def['header .fjd-avatar'] = 'width:2rem; height:2rem; flex:none; border-radius:50%; object-fit:cover; display:inline-block;';
$def['header .fjd-avatar-initial'] = 'display:inline-flex; align-items:center; justify-content:center; background:rgba(0,216,255,.25); font-weight:600; font-size:.875rem;';
foreach ([&$xsm_screen, &$sm_screen, &$lg_screen] as &$_scr) {
    $_scr['header'] = 'display:flex; flex-wrap:nowrap; justify-content:space-between;';
    $_scr['header > div:first-child'] = 'flex:1 1 auto; max-width:none;';
    $_scr['header > nav'] = 'flex:0 0 auto;';
    $_scr['header .menu-host'] = 'display:none; grid-template-columns:none; height:auto;';
    $_scr['.fjd-menu-check:checked ~ .menu-host'] = 'display:flex; flex-direction:column; align-items:stretch; gap:.75rem;';
    $_scr['header .menu-host ul'] = 'flex-direction:column; align-items:stretch; overflow:visible;';
    $_scr['header .fjd-burger'] = 'display:flex;';
