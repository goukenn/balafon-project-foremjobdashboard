<?php

use com\igkdev\projects\ForemJobDashboard\Models\JobEnterprises;
use com\igkdev\projects\ForemJobDashboard\Models\JobStatusTypes;
use com\igkdev\projects\ForemJobDashboard\Models\Jobs;
use com\igkdev\projects\ForemJobDashboard\StatusTypes;
use IGK\Database\DbQueryCondition;
use IGK\System\Database\SQLQueryFieldPrefixOperators;
use IGK\System\Html\SVG\SvgRenderer;
use function igk_resources_gets as __;
use function igk_html_host as _h;

/**
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $data
 * @var mixed $fname
 * @var mixed $params
 * @var mixed $entry_uri
 * @var mixed $data
 */

$bg_color = '#040809';
if (!$ctrl->checkUser(false) && igk_environment()->isDev()) {
    if ($ulogin = $ctrl->getConfigs()->{'app.default-user'}) {
        $tuser = igk_get_user_bylogin($ulogin);
        $ctrl::login($tuser, null, null);
        $user = $ctrl->getUser();
    }
}
if (!$user) {
    igk_die('missing user');
}
$create_at = $data->create_at;
include_once $ctrl::getViewDir() . '/.auth.pinc';
 
$doc->title = sprintf('Job - %s', $ctrl->getAppTitle());
$doc->getMetas()->lastUpdate =  'Wed, 01 Oct 2025 12:00:00 GMT';
$doc->setHeaderColor($bg_color);
$doc->getbody()->setStyle('background-color: ' . $bg_color);
$def = $doc->getTheme();
$def['.svg.sfsymbol'] =
    $def['svg.sfsymbol'] =
    'display:inline-block; width:32px; height:32px; color:var(--igk-link-color);';
if ($header = $ctrl->getEnvParam('header')) {
    $header->top->div()->host(function ($t) use ($ctrl) {
        $t->a($ctrl::uri('@/'), 'home')->svguse('house.fill');
    });
    $r = _h(
        $header->top,
        _h('li > span',  igk_svg_use('forem.jobs')),
        _h('li > a', [$ctrl::uri('@/jobs/add'), 'content'=> __('add')]),
    );
}
$active_job_tab = 'list';
include $ctrl::getViewDir() . '/jobs/.tabs.pinc';
$form = _h('form.search');
$form['action'] = $entry_uri . '/search';
$form->fields(['search' => ['value' => $create_at, 'attribs' => ['autocomplete' => 'off']]]);
$form->actionbar()->submit()->setClass('dispib')->setAttribute('value', __('search'));
_h(
    $t->section()->container()->row()->col(),
    _h('h2', __('searching data')),
    $form
);

if ($r = $data->result) {
    $t->div()->container()->row()->col()->div()->host(function ($n, $uri) use ($data) {
        $r = $data->result;
        $ul = $n->ul();
        foreach ($r as $row) {
            $is_closed = isset($row->status->{JobStatusTypes::FD_NAME}) && $row->status->{JobStatusTypes::FD_NAME} == StatusTypes::CLOSED;
            $needs_action = !$is_closed && !empty($row->{Jobs::FD_FOLLOW});
            $li = $ul->li()->a();
            $li['class'] = 'dispflex flex-row gap-4' . ($is_closed
                ? ' tw-text-red-600 dark:tw-text-red-400'
                : ($needs_action ? ' tw-text-yellow-600 dark:tw-text-yellow-400' : ''));
            $li['href'] = $uri . '/edit/' . $row->{Jobs::FD_ID};
            $li->span($row->{Jobs::FD_CREATE_AT});
            $li->span($row->{Jobs::FD_TITLE});
            $li->span(isset($row->enterprise->name) ? '- [' . $row->enterprise->name . ']' : '-');
        }
    }, $ctrl::uri($fname));
}
