<?php
// @author: C.A.D. BONDJE DOUE
// @file: jobs/.tabs.pinc
// @desc: shared tab control for the jobs section (List / Add), Tailwind-styled
use function igk_resources_gets as __;

/**
 * @var mixed $t
 * @var mixed $ctrl
 * @var string $active_job_tab 'list'|'add'
 */
$job_tabs = [
    'list' => ['label' => __('list'), 'href' => $ctrl::uri('@/jobs')],
    'add' => ['label' => __('add'), 'href' => $ctrl::uri('@/jobs/add')],
];
$job_tabs_nav = $t->nav();
$job_tabs_nav->setClass('flex flex-row gap-2 mb-4 border-b border-gray-200 dark:border-gray-700');
foreach ($job_tabs as $job_tab_key => $job_tab) {
    $job_tab_active = $job_tab_key === ($active_job_tab ?? 'list');
    $job_tab_a = $job_tabs_nav->a();
    $job_tab_a['href'] = $job_tab['href'];
    $job_tab_a->Content = $job_tab['label'];
    $job_tab_a->setClass('px-4 py-2 -mb-px border-b-2 font-medium text-sm ' . ($job_tab_active
        ? 'border-blue-600 text-blue-600'
        : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'));
}
