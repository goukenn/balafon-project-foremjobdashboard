<?php
// @author: C.A.D. BONDJE DOUE
// @file: jobs/.tabs.pinc
// @desc: shared tab control for the jobs section (List / Add), Tailwind-styled
use function igk_resources_gets as __;

/**
 * @var mixed $t
 * @var mixed $ctrl
 * @var string $active_job_tab 'list'|'add'|'duplicates'
 */
$job_tabs = [
    'list' => ['label' => __('list'), 'href' => $ctrl::uri('@/jobs')],
    'add' => ['label' => __('add'), 'href' => $ctrl::uri('@/jobs/add')],
    'duplicates' => ['label' => __('duplicates'), 'href' => $ctrl::uri('@/jobs/duplicates')],
];
$job_tabs_nav = $t->nav();
$job_tabs_nav->setClass('tw-flex tw-flex-row tw-gap-2 tw-mb-4 tw-border-b tw-border-gray-200 dark:tw-border-gray-700');
foreach ($job_tabs as $job_tab_key => $job_tab) {
    $job_tab_active = $job_tab_key === ($active_job_tab ?? 'list');
    $job_tab_a = $job_tabs_nav->a();
    $job_tab_a['href'] = $job_tab['href'];
    $job_tab_a->Content = $job_tab['label'];
    $job_tab_a->setClass('tw-px-4 tw-py-2 -tw-mb-px tw-border-b-2 tw-font-medium tw-text-sm ' . ($job_tab_active
        ? 'tw-border-blue-600 tw-text-blue-600'
        : 'tw-border-transparent tw-text-gray-500 hover:tw-text-gray-700 hover:tw-border-gray-300'));
}
