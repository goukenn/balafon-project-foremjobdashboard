 igk_view_handle_actions($fname, [
    'docs' => function (Jobs $job) use (& $params, $ctrl, $fname){
        $store = function($job, $s, $responseType, $force_insert=false){
              $cond = [
                JobDocs::FD_JOB_ID => $job->id,
                JobDocs::FD_JOB_DOC_TYPE_ID => $responseType->id,
            ];
            if (!$force_insert && ($hvi = JobDocs::select_row($cond))){
                $hvi->{JobDocs::FD_VALUE} =  $s;
                $hvi->save();
                igk_wln('update ', $hvi->to_array(), $s);
            } else {
                $cond[JobDocs::FD_VALUE] = $s;
                JobDocs::insert( $cond);
                igk_wln('insert ');
            }
        };
        // igk_wln("handler.....docs");
        $params = [$job->{Jobs::FD_ID}];
        $tid = JobDoctypes::GetCache('id', igk_getr('type'));
    
        if (($file = igk_getv($_FILES, 'file')) && ($file['error']==0)){
            $ext = '.pdf';
            $path = uniqid('doc').$ext;

            $dir = Path::Combine($ctrl->getDataDir(), $ctrl->getUserProfile()->model()->clLogin);
            igk_io_move_uploaded_file($file['tmp_name'], Path::Combine($dir,  $path));
            $s =  json_encode((object)[ 
                'path' => $path,
                'type' => $file['type'],
                'size' => $file['size']
            ], JSON_UNESCAPED_UNICODE); 
            $store($job, $s, $tid);  
        }
        if ($msg = igk_getr('msg')){
            $msg = str_replace("\r", "", $msg);
            $s =  json_encode((object)[
                'content' => $msg,
                'type' => 'template',
                'size' => strlen($msg)
            ], JSON_UNESCAPED_UNICODE);
            $store($job, $s, $tid);          
        }
        igk_navto($ctrl::uri($fname.'/'.$job->{Jobs::FD_ID}));
    },
    'contact' => function (Jobs $job)  use (& $params,$ctrl, $fname){
        // igk_wln("handler.....contact");
        $params = [$job->{Jobs::FD_ID}];
        igk_navto($ctrl::uri($fname.'/'.$job->{Jobs::FD_ID}));
    }
], $params);
