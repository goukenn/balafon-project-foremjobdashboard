$t->script()->Content = <<<'JS'
(function(){
    var btns = document.querySelectorAll('.fjd-tab-btn');
    var panels = document.querySelectorAll('.fjd-tab-panel');
    btns.forEach(function(btn){
        btn.addEventListener('click', function(){
            var target = btn.getAttribute('data-fjd-tab');
            btns.forEach(function(b){
                b.classList.remove('tw-border-blue-600', 'tw-text-blue-600');
                b.classList.add('tw-border-transparent', 'tw-text-gray-500', 'dark:tw-text-gray-400');
            });
            btn.classList.remove('tw-border-transparent', 'tw-text-gray-500', 'dark:tw-text-gray-400');
            btn.classList.add('tw-border-blue-600', 'tw-text-blue-600');
            panels.forEach(function(p){
                p.classList.toggle('hidden', p.getAttribute('data-fjd-panel') !== target);
            });
        });
    });
})();
JS;

