/**
 * @var mixed $t
 */
$modules->require(Modules::igk_ios_SfSymbols());
/**
 * @type IJobPostData
 * @property string $title
 * @property string $desc
 */
include_once $ctrl::getViewDir() . '/.auth.pinc';
if (igk_server()->method('POST') &&  igk_getr("btn-delete")) {
    $id = igk_getv($params, 0);
    if ($job = Jobs::GetCache(Jobs::FD_ID, $id)) {
        $job->delete();
        igk_navto($ctrl::uri('@/jobs'));
    }
}
igk_view_handle_actions($fname, [
    'docs' => function (Jobs $job, $type=null, ?Request $request=null) use (&$params, $ctrl, $fname) {
        if ($request->method('POST')){
            DocsAction::CreateInstance($ctrl)->index_post($job, $type);        
        }
        igk_navto($ctrl::uri($fname . '/' . $job->{Jobs::FD_ID}));
    },
    'contact' => function (Jobs $job, ?Request $request = null)  use (&$params, $ctrl, $fname) {
        if (!$request->method('POST')) {
            return;
        }
        $data = $request->getFormData();
        $obj = igk_extract_obj($data, 'name|email|phone|address');
        $l = Activator::CreateNewInstance(ContactDataInfo::class,$obj);
        $r = JobContacts::Add('-', $obj->name, null, null, JSon::EncodeWithNoEmpty($l)); 
        if ($r) {
            $job->{JOBS::FD_CONTACT_ID} = $r->{JobContacts::FD_ID};
            $job->save();
        }
        igk_navto($ctrl::uri($fname . '/' . $job->{Jobs::FD_ID}));
    }
], $params);
if (!$params) {
    $t->div()->panel()->danger()->Content = __('Not allowed');
    return;
}
$id = igk_getv($params, 0);
$row = Jobs::GetCache(Jobs::FD_ID, $id);
if ($request->method('POST')) {
    /**
     * @var IJobPostData 
     */
    $obj = $request->getFormData(); 
    if ($obj->title) {
        $desc = $obj->description;
        $desc = str_replace("\r", "", $desc);
        $obj->description = substr(preg_replace("/\n+/", "\n", $desc), 0, 2500);   
        $obj->summary = substr($obj->summary ?? $obj->description, 0, 2500);     
        $e_utility = $ctrl->modelUtility('enterprise');
        $row->{Jobs::FD_TITLE} = $obj->title;
        $row->{Jobs::FD_DESCRIPTION} = $obj->description;
        $row->{Jobs::FD_SUMMARY} = $obj->summary;
        $row->{Jobs::FD_FROM_ID} = $obj->from ?? JobSourceTypes::GetCacheColumn(
            JobSourceTypes::FD_ID,
            ForemJobDashboardSourceTypes::WEB
        );
        $row->{Jobs::FD_STATUS_ID} = $obj->status ?? $row->{Jobs::FD_STATUS_ID};
        $e = $obj->enterprise;
        $c_eid = Jobs::FD_ENTERPRISE_ID;
        $row->{$c_eid} = $e ? $e_utility->registerEnterprise($e) : null;
        $row->{Jobs::FD_CATEGORY_ID} = $obj->category; 
        $row->{Jobs::FD_TYPE_ID} = $obj->regtype;
        $row->save();
        if ($obj->forem_ref){
            $row->attachForemReference($obj->forem_ref);
        }
    }
}
if (!$row) {
    $t->div()->panel()->content = __('Missing Entries');
    return;
} 
$forem_ref = $row->foremReference(); 
if ($header = $ctrl->getEnvParam('header')) {
    _h($header->top, _h('li > a', [$ctrl::uri('@/jobs/add')], __('add')),);
}
$def = $doc->getTheme();
$def['.min-h-1'] = 'min-height:100%;';
$doc->title = 'edit - ' . htmlentities($row->title);
$t['class'] = '+min-h-1 -fit';
$head = $t->div()->container();
$head->h2()->Content = __('Edit');
$b = $t->div()->container();
$sdata = JobStatusTypes::formSelectData();
$edid = $row->{Jobs::FD_ENTERPRISE_ID};
$e = (function ($edid) {
    if ($edid) {
        return JobEnterprises::Get(JobEnterprises::FD_ID, $edid);
    }
})($edid);
$frow = $b->row();
$form = $frow->col()->div()->form();
$form['action'] = $ctrl::uri($fname . '/' . $id);
$form['enctype'] = 'multipart/form-data';
$form->label()->content = $row->{Jobs::FD_CREATE_AT};
$fforem_attribs = [];
if ($forem_ref && !$ctrl::isUserAllowedTo(EnumAuthorizations::update_forem_reference)){
    $fforem_attribs = [
        'readonly',
        'class'=>'readonly'
    ];
}
$form->fields([
    'title' => ['value' => $row->{Jobs::FD_TITLE}],
    'enterprise' => [
        'value' => $e ? $e->{JobEnterprises::FD_NAME} : null
    ],
    'forem_ref' => [
        'value' => $forem_ref,
        'placeholder' => 'forem reference',
        'label_text' => 'Forem Reference',
        'autocomplete' => HtmlAutocompleteValues::NOPE,
        'attribs'=>$fforem_attribs
    ],
    'description' => ['type' => 'textarea', "attribs"=>["maxlength" => 2500], 'value' => $row->{Jobs::FD_DESCRIPTION}],
    'summary' => ['type' => 'textarea', "attribs"=>["maxlength" => 2500], 'value' => $row->{Jobs::FD_SUMMARY}],
    'from' => [
        'type' => 'select',
        'selected' => $row->{Jobs::FD_FROM_ID},
        'data' => array_merge(JobSourceTypes::formSelectData(), [])
    ],
    'status' => [
        'type' => 'select',
        'selected' => $row->{Jobs::FD_STATUS_ID},
        'data' => array_merge($sdata, [])
    ],
    'regtype' => [
        'type' => 'select',
        'selected' => $row->{Jobs::FD_TYPE_ID},
        'data' => JobRegisterTypes::formSelectData()
    ],
    'category' => [
        'type' => 'select',
        'selected' => $row->{Jobs::FD_CATEGORY_ID},
        'data' => ModelsJobCategories::formSelectData()
    ]
]);
$form->actionbar()->host(function ($a) {
    $a->submit('', __('update'))->setClass('dispib');
    $a->submit('btn-delete', __('delete'))->setClass('dispib');
});
$col = $frow->col();
$col['class'] = 'dispflex.flex-column';
$form = $col->div()->form();
$form['action'] = $ctrl::uri($fname . '/docs/' . $id);
$form['enctype'] = 'multipart/form-data';
// + | ------------------------------------------------
// + | get document 
// + |
$docs = JobDocs::select_all([JobDocs::FD_JOB_ID => $id]);
$p = $form->panel();
$p->xmlnode('code')->Content = __("File or Text-message");
$p->remove();
$response = '';
$default_response = ForemJobDashboardJobDocTypes::RESPONSE();
if ($rp = JobDocs::select_row([JobDocs::FD_JOB_ID => $id, JobDocs::FD_JOB_DOC_TYPE_ID => $default_response ? $default_response->id : null])) {
    if ($ts = json_decode($rp->value)) {
        if ($ts->type == 'template') {
        }
    }
}
$form->fields([
    ['type' => 'fieldset', 'legend' => 'docs'],
    'jid' => ['type' => 'hidden', 'value' => $id],
    'type' => [
        'type' => 'select',
        'data' => JobDoctypes::formSelectData(),
        'value'=> $default_response ? $default_response->id : null
    ],
    $p,
    'file' => ['type' => 'file'],
    'msg' => ['type' => 'textarea', 'value' => $response]
]);
$form->actionbar()->host(function ($a) {
    $a->submit('', __('update'))->setClass('dispib');
});
// + | count njumber of columnet 
$form->add(_h('div.counter', sprintf(__('documents: %s'), count($data->docs ?? []))));
_h(
    $col->div(),
    _h('ul', _h(
        'li > a.btn[href:'.$ctrl::uri('@/docs/').$id.']', __('view documents')
    )),
    _h('ajxa.clear-docs', [$ctrl::uri('@/jobs/edit/clear-docs/' . $id)], __('clear document'))->setAttribute('method', 'post')
);
$form = $frow->col()->div()->form();
$form['action'] = $ctrl::uri($fname . '/contact/' . $id);
$m = $row->{Jobs::FD_CONTACT_ID};
(function($form, $m, $id){
    $d = [];
    if ($m){
        $r = JobContacts::GetCache(JobContacts::FD_ID, $m);
        $info = Activator::CreateNewInstance(ContactDataInfo::class, json_decode($r->{$r::FD_DATA}));
        if ($info instanceof ContactDataInfo){
            $d['name'] = $info->name;
            $d['email'] = $info->email;
            $d['phone'] = $info->phone;
            $d['address'] = $info->address;
        }
    }
$form->fields([
    ['type' => 'fieldset', 'legend' => __('contact')],
        'name' => igk_getv($d, 'name', ''),
        'email' => igk_getv($d, 'email', ''),
        'phone' => igk_getv($d, 'phone', ''),
        'address' => igk_getv($d, 'address', ''),
        'contact_id'=>['type'=>'hidden', 'value'=>$m ? $m : null],
    ['type' => 'efieldset'],
    'jid' => ['type' => 'hidden', 'value' => $id]
]);
})($form, $m, $id);
$form->actionbar()->host(function ($a) {
    $a->submit('', __('update2'))->setClass('dispib');
});
$t->section()->container()->col()->row()->actionbar()->host(function ($a, $ctrl, $id, $fname) {
    $a->a()->setAttributes([
        'class' => 'igk-btn',
        'href' => $ctrl::uri(dirname($fname))
    ])->Content = __('home');
    $a->a()->setAttributes([
        'class' => 'igk-btn',
        'href' => $ctrl::uri(dirname($fname) . '/edit/' . ($id + 1))
    ])->Content = __('next');
}, $ctrl, $id, $fname);
$footer = $t->div()->container();
_h(
    $t->container()->col()->div(),
    'Follow: ' . $row->follow,
    function ($n) {
        $n->add(
            _h(
                'span.shared',
                igk_html_node_usesvg('square.and.arrow.up.circle.fill'),
                _h('label', [''], ':>presentation<:')
            )
        );
    }
);