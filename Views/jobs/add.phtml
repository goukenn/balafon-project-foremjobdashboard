<?php
use com\igkdev\projects\ForemJobDashboard\Models\JobEnterprises;
use com\igkdev\projects\ForemJobDashboard\Models\Jobs;
use com\igkdev\projects\ForemJobDashboard\Models\JobSourceTypes;
use com\igkdev\projects\ForemJobDashboard\Helpers\JobUtility;
use com\igkdev\projects\ForemJobDashboard\ModelUtilities\MainTaskModelUtility;
use function igk_html_host as _h;
use function igk_resources_gets as __;

include_once $ctrl::getViewDir().'/.auth.pinc';
igk_view_handle_actions($fname, [
    'store'=>function()use($user, $ctrl){
        igk_server()->method('POST') || igk_die('post is required');
        $title = igk_getr('title');
        $enterprise = igk_getr('enterprise');
        $desc = igk_getr('description');
        $summary = igk_getr('summary');
        if (($main = $ctrl->modelUtility("MainTask")) instanceof MainTaskModelUtility){
            $eid = null;
            if ($enterprise){
                if ($c = JobEnterprises::GetCache(JobEnterprises::FD_NAME, $enterprise, true)){
                    $eid = $c->id;
                }
            } 
            if (($c = $main->addJob($title, $user)) instanceof Jobs){ 
                $c->enterprise_id = $eid;
                $c->description = substr($desc, 0, 2600);
                $c->summary = $summary;
                $c->from_id = igk_getr('from');
                $c->category_id = igk_getr('category') ?? $c->category_id;
                if (($follow = igk_getr('follow_at')) && strtotime($follow)) {
                    $c->follow_at = date('Y-m-d', strtotime($follow));
                }
                if ($create_at = igk_getr('date')){
                    $c->Create_At = igk_date_display_date($create_at, 'Y-m-d H:i:s');
                }
                $c->update();
                $ctrl->setEnvParam('job', $c);
            } 
        }
    },
], $params);
if ($header = $ctrl->getEnvParam('header')) {    
    $r = _h(
        $header->top,
        _h('li > a', [$ctrl::uri('@/jobs')], igk_svg_use('forem.jobs')),  
    );
}
$active_job_tab = 'add';

// + | ------------------------------------------------
// + | layout: same charter as enterprise/add and jobs/default (Tailwind cards, dark/light)
// + |
$doc->title = __('add') . ' - ' . $ctrl->getAppTitle();
// setClass() mangles '/' and ':' in class names (tw-bg-red-500/15, dark:...), so set the attribute directly
$tw = function ($node, string $classes) {
    $node['class'] = $classes;
    return $node;
};
$btn = 'tw-px-4 tw-py-2 tw-rounded-lg tw-text-sm tw-font-medium tw-no-underline tw-cursor-pointer tw-border tw-border-gray-300 dark:tw-border-gray-700 tw-bg-white dark:tw-bg-gray-900 tw-text-gray-800 dark:tw-text-gray-200 hover:tw-bg-gray-100 dark:hover:tw-bg-gray-800';
$btn_main = 'tw-px-4 tw-py-2 tw-rounded-lg tw-bg-blue-600 hover:tw-bg-blue-700 tw-text-white tw-text-sm tw-font-medium tw-no-underline tw-cursor-pointer tw-border-0';
$input = 'tw-w-full tw-px-3 tw-py-2 tw-rounded-lg tw-border tw-border-gray-300 dark:tw-border-gray-700 tw-bg-white dark:tw-bg-gray-900 tw-text-gray-900 dark:tw-text-gray-100';
$card_cls = 'tw-flex tw-flex-col tw-gap-3 tw-p-4 tw-rounded-xl tw-border tw-border-gray-200 dark:tw-border-gray-800 tw-bg-white dark:tw-bg-gray-900';
$label_cls = 'tw-flex tw-flex-col tw-gap-1 tw-text-sm tw-font-medium tw-text-gray-700 dark:tw-text-gray-300';
$hint_cls = 'tw-text-xs tw-text-gray-500 dark:tw-text-gray-400 tw-m-0';

// the shared jobs tab control, like on @/jobs
include $ctrl::getViewDir() . '/jobs/.tabs.pinc';
$page = $tw($t->main(), 'tw-flex tw-flex-col tw-gap-4 tw-pb-8 tw-w-full tw-max-w-4xl tw-mx-auto tw-px-4 grow-1');

// + | header
$tw($head = $page->div(), 'tw-flex tw-flex-row tw-items-center tw-justify-between tw-gap-3');
$tw($head->h2(), 'tw-text-2xl tw-font-bold tw-m-0')->Content = __('Add a job offer');
$back = $tw($head->a(), $btn);
$back['href'] = $ctrl::uri('@/jobs');
$back->Content = __('cancel');
$tw($page->p(), $hint_cls . ' tw-text-sm')->Content = __('Archive an offer found online. You can complete it later from the edit page.');

if ($j = $ctrl->getEnvParam('job')) {
    $ok = $tw($page->div(), 'tw-flex tw-items-center tw-justify-between tw-gap-3 tw-p-3 tw-rounded-lg tw-border tw-border-green-400 tw-bg-green-50 dark:tw-bg-green-900 tw-text-green-900 dark:tw-text-green-100 tw-text-sm');
    $ok['role'] = 'status';
    $ok->span()->Content = __('Job offer added.') . ' ' . $j->title;
    $e = $tw($ok->a(), 'tw-font-semibold tw-no-underline tw-text-green-900 dark:tw-text-green-100 hover:tw-underline');
    $e['href'] = $ctrl::uri('@/jobs/edit/' . $j->id);
    $e->Content = __('edit') . ' →';
}

$enterprises = [];
foreach (JobEnterprises::select_all([], ['Limit' => 300]) ?: [] as $e) {
    $enterprises[] = $e->{JobEnterprises::FD_NAME};
}
sort($enterprises, SORT_NATURAL | SORT_FLAG_CASE);

$frm = $tw($page->form(), 'tw-flex tw-flex-col tw-gap-4');
$frm['method'] = 'post';
$frm['action'] = $ctrl::uri($fname . '/store');

$ucf = function (string $s) {
    return mb_strtoupper(mb_substr($s, 0, 1)) . mb_substr($s, 1);
};
// one labelled control inside a card grid
$field = function ($parent, string $name, string $label, string $type = 'text', array $attr = [], bool $wide = false, string $value = '') use ($tw, $input, $label_cls, $ucf) {
    $l = $tw($parent->label(), $label_cls . ($wide ? ' md:tw-col-span-2' : ''));
    $l->span($ucf($label));
    if ($type === 'textarea') {
        $c = $tw($l->textarea(), $input);
        $c['name'] = $name;
        $c['style'] = 'resize:vertical';
    } else {
        $c = $tw($l->input($name, $type, $value), $input);
    }
    foreach ($attr as $k => $a) {
        $c[$k] = $a;
    }
    return $c;
};
$section = function (string $label) use ($frm, $tw, $card_cls) {
    $card = $tw($frm->div(), $card_cls);
    $tw($card->h3(), 'tw-text-lg tw-font-semibold tw-m-0')->Content = $label;
    return $tw($card->div(), 'tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-3');
};

// + | the offer
$g = $section(__('Offer'));
$field($g, 'title', __('title'), 'text', ['required' => 'required', 'autofocus' => 'autofocus', 'autocomplete' => 'off', 'maxlength' => 150], true);
$field($g, 'enterprise', __('enterprise'), 'text', ['list' => 'fjd-enterprises', 'autocomplete' => 'off', 'maxlength' => 100], true);
$dl = $g->add('datalist');
$dl['id'] = 'fjd-enterprises';
foreach ($enterprises as $name) {
    $dl->add('option')->setAttribute('value', $name);
}
$field($g, 'description', __('description'), 'textarea', ['rows' => 6, 'maxlength' => 2500, 'data-fjd-count' => 2500, 'style' => 'resize:vertical;height:10rem'], true);
$field($g, 'summary', __('summary'), 'textarea', ['rows' => 3, 'maxlength' => 300, 'data-fjd-count' => 300, 'style' => 'resize:vertical;height:6rem'], true);

// + | where / when
$g = $section(__('Source and dates'));
$web = JobSourceTypes::GetCache(JobSourceTypes::FD_NAME, 'WEB');
$l = $tw($g->label(), $label_cls);
$l->span($ucf(__('from')));
$sel = $tw($l->select(), $input);
$sel['name'] = 'from';
foreach (JobSourceTypes::formSelectData() as $item) {
    $o = $sel->option();
    $o['value'] = $item['i'];
    if ($web && (string)$item['i'] === (string)$web->id) {
        $o['selected'] = 'selected';
    }
    $o->Content = $item['t'];
}
$field($g, 'date', __('date'), 'date', [], false, date('Y-m-d'));
$field($g, 'follow_at', __('Follow-up date'), 'date', [], false, JobUtility::DefaultFollowAt());
$tw($g->p(), $hint_cls . ' md:tw-col-span-2')->Content = __('Default follow-up: one week after today.');

// + | actions
$tw($bar = $frm->div(), 'tw-flex tw-gap-2');
$b = $tw($bar->button(), $btn_main);
$b['type'] = 'submit';
$b->Content = __('add');
$c = $tw($bar->a(), $btn);
$c['href'] = $ctrl::uri('@/jobs');
$c->Content = __('cancel');

// live character counters for the limited fields
$t->script()->Content = <<<'JS'
(function(){
  document.querySelectorAll('[data-fjd-count]').forEach(function(f){
    var max = +f.getAttribute('data-fjd-count'), c = document.createElement('div');
    c.className = 'tw-text-xs tw-text-gray-500 dark:tw-text-gray-400 tw-text-right';
    f.insertAdjacentElement('afterend', c);
    function u(){ c.textContent = f.value.length + ' / ' + max; }
    f.addEventListener('input', u); u();
  });
})();
JS;
