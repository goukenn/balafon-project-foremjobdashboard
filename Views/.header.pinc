<?php
// @author: C.A.D. BONDJE DOUE
// @file: .header.pinc
// @date: 20240904 08:59:55
use IGK\Helper\ViewHelper;
use IGK\System\Html\SVG\SvgRenderer;
use function igk_html_host as _h;

/**
 * @var mixed $doc
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $modules
 * @var mixed $fname
 * @var mixed $layout
 */
$resolver = IGKResourceUriResolver::getInstance();
$asset_dir = $ctrl->getDataDir() . '/assets';
$resolver->resolve($asset_dir);
$twlink = $doc->head->link();
$twlink['rel'] = 'stylesheet';
$twlink['href'] = $resolver->resolve($asset_dir. '/css/tailwind.css');

$modules->require('igk.ios.SfSymbols');
SvgRenderer::RegisterFolder($asset_dir.'/svg');
igk_google_addfont($doc, "Roboto");
$t->setClass("+google-Roboto fit overflow-y-a");
$img = _h('img', [$ctrl->getDataDir() . '/assets/img/logo.jpg'])->setSize(64, 64);
if ($fname == 'default') {
    $h = $img;
} else {
    $h = _h('a.dispflex.tw-cursor-pointer', [$ctrl::uri('@/'), 'content'=>null], $img);
}
function viewAuth()
{
    $ctrl = ViewHelper::CurrentCtrl();
    if ($user = $ctrl->getUser()) {
        $wrap = igk_create_node('div');
        $wrap->setClass('tw-relative tw-group pad4 tw-cursor-pointer');
        $wrap['tabindex'] = 0;
        $wrap['aria-haspopup'] = 'menu';
        $model = $user->model();
        $login = (string)$model->clLogin;
        $who = $wrap->div()->setClass('fjd-user');
        if ($picture = trim((string)($model->clPicture ?? ''))) {
            $who->img()->setClass('fjd-avatar')->setAttributes(['src' => $picture, 'alt' => $login, 'width' => 32, 'height' => 32, 'loading' => 'lazy']);
        } else {
            $who->span()->setClass('fjd-avatar fjd-avatar-initial')->Content = strtoupper(mb_substr($login, 0, 1));
        }
        $who->span()->setClass('fjd-user-login')->Content = $login;

        $box = igk_create_node('div');
        $box->setClass('box tw-hidden group-hover:tw-block group-focus-within:tw-block tw-absolute tw-right-0 tw-top-full tw-min-w-[8rem] tw-bg-white dark:tw-bg-gray-800 tw-border tw-border-gray-200 dark:tw-border-gray-700 tw-rounded-lg tw-shadow tw-z-10');
        $box['role'] = 'menu';
        // + | other items come from the filter; each item: ['label'=>..., 'href'=>..., 'icon'=>?]
        $items = igk_hook(
            \com\igkdev\projects\ForemJobDashboard\FJDHooks::FILTER_USER_CONTEXT_MENU,
            ['ctrl' => $ctrl, 'filter' => [], 'user' => $user],
            ['output' => []]
        );
        $v_sep = false;
        foreach (is_array($items) ? $items : [] as $item) {
            if (!is_array($item) || empty($item['label']) || empty($item['href'])) {
                continue;
            }
            $a = $box->a($item['href']);
            $a['role'] = 'menuitem';
            $a->setClass('tw-block tw-px-4 tw-py-2 tw-text-sm tw-text-gray-700 dark:tw-text-gray-200 hover:tw-bg-gray-100 dark:hover:tw-bg-gray-700');
            $a->Content = $item['label'];
            $v_sep = true;
        }
        // + | logout is always the last action
        $link = igk_create_node('a');
        $link['role'] = 'menuitem';
        $link['href'] = $ctrl::uri('@/logout');
        $link->Content = __('logout');
        $link->setClass('tw-block tw-px-4 tw-py-2 tw-text-sm tw-text-gray-700 dark:tw-text-gray-200 hover:tw-bg-gray-100 dark:hover:tw-bg-gray-700');
        if ($v_sep){
            $box->hsep(); // add()
        }
        $box->add($link);
        $wrap->add($box);
        return $wrap;
    } else if (igk_environment()->isDev()){
        $auth = igk_create_node('div.autolog');
        $auth->a('@/autolog')->content = 'AutoLog';
    }
}
function themeToggleButton()
{
    $btn = igk_create_node('button');
    $btn->setClass('igk-winui-toggle-theme tw-px-3 tw-py-2 tw-rounded-lg tw-bg-gray-200 dark:tw-bg-gray-700 hover:tw-bg-gray-300 dark:hover:tw-bg-gray-600 tw-transition tw-text-sm tw-font-medium');
    $btn->id = 'theme-toggle';
    $btn->type = 'button';
    $btn->setAttribute('aria-label', 'Toggle dark mode');
    $btn->Content = '🌙';
    return $btn;
}
$menu = _h('div.menu-host', $menu_l = _h('div.menu.dispflex.flex-row.alignc'));
// + | tools (language, theme, user) live inside the menu host: inline on wide screens, in the mobile menu otherwise
$prefs = $menu->div()->setClass('fjd-nav-prefs');
// + | language selector (same approach as igk_html_node_igk_choose_lang_selector): ajax post on <base>/<lang>, then reload
$supported = \IGK\Resources\R::GetSupportedLangs();
$langs = $prefs->div()->setClass('fjd-lang');
$select = $langs->select();
$select->setAttributes([
    'name'=>'langsel',
    'aria-label' => __('Language')]);
foreach ($supported as $lg) {
    $opt = $select->option()->setAttributes(['value' => $lg]);
    $opt->Content = strtoupper($lg);
    if (strtolower(\IGK\Resources\R::GetCurrentLang()) === strtolower($lg)) {
        $opt['selected'] = 'selected';
    }
}
list($uri, $query) = igk_html_lang_uri();
//$select['onchange'] = "javascript:(function(p){fetch('" . rtrim(igk_io_baseuri(), '/') . "/'+p.value+'/?view=1',{method:'POST',credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}});});})(this);";
// the ajax post only stores the language; the page is then reloaded with a GET: re-rendering the current view from
// the post response shows it without its action data (empty jobs / enterprise lists)
$select["onchange"] = "javascript: (function(p){fetch('" . $uri . "/'+p.value+'" . $query . "',{method:'POST',credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(){window.location.reload();});})(this);";
       

$prefs->add(themeToggleButton());
if ($auth_node = viewAuth()) {
    $menu->div()->setClass('fjd-nav-auth')->add($auth_node);
}
// + | mobile (xsm, sm): the menu is collapsed behind a burger, toggled with a css-only checkbox
$burger = _h('input#fjd-menu-toggle.fjd-menu-check');
$burger->setAttributes(['type' => 'checkbox', 'aria-label' => __('Menu')]);
$burger_label = _h('label.fjd-burger', _h('span'), _h('span'), _h('span'));
$burger_label->setAttributes(['for' => 'fjd-menu-toggle', 'aria-label' => __('Menu')]);
$nav = _h('nav.flex.flex-row.flex-alignc', $burger, $burger_label, $menu);
$t->add(_h(
    'header.dispflex.flex-row.flex-justify-sb.possticky',
     _h('div.flex.flex-row.flex-alignc.gap-10px.no-shrink',
        $h,    
        _h('h2.no-wrap.no-shrink.sm-dispn.xsm-dispn', $this->getConfigs()->clTitle ?? '')
     ),
     $nav
));
$ctrl->setEnvParam('header', (object)[
    'top' => $menu_l,
    'nav'=> $nav
]);
 
// igk_wln_e((new ReflectionClass(get_class($layout)))->getFileName());
$layout->attachScrollTo($doc, $t);