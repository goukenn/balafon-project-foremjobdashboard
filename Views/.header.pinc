use IGK\Helper\ViewHelper;
use IGK\System\Html\SVG\SvgRenderer;
use function igk_html_host as _h;

/**
 * @var mixed $doc
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $modules
 */
$resolver = IGKResourceUriResolver::getInstance();
$asset_dir = $ctrl->getDataDir() . '/assets';
$resolver->resolve($asset_dir);
$twlink = $doc->head->link();
$twlink['rel'] = 'stylesheet';
$twlink['href'] = $resolver->resolve($asset_dir. '/css/tailwind.css');

$modules->require('igk.ios.SfSymbols');
SvgRenderer::RegisterFolder($asset_dir.'/svg');
igk_google_addfont($doc, "Roboto");
$t->setClass("+google-Roboto fit overflow-y-a");
$img = _h('img', [$ctrl->getDataDir() . '/assets/img/logo.jpg'])->setSize(64, 64);
if ($fname == 'default') {
    $h = $img;
} else {
    $h = _h('a.dispflex.tw-cursor-pointer', [$ctrl::uri('@/')], $img);
}
function viewAuth()
{
    $ctrl = ViewHelper::CurrentCtrl();
    if ($user = $ctrl->getUser()) {
        $wrap = igk_create_node('div');
        $wrap->setClass('tw-relative group pad4 tw-cursor-pointer');
        $wrap->add(_h('span', $user->model()->clLogin));

        $box = igk_create_node('div');
        $box->setClass('box tw-hidden group-hover:tw-block tw-absolute tw-right-0 tw-top-full tw-min-w-[8rem] tw-bg-white dark:tw-bg-gray-800 tw-border tw-border-gray-200 dark:tw-border-gray-700 tw-rounded-lg tw-shadow tw-z-10');
        $link = igk_create_node('a');
        $link['href'] = $ctrl::uri('@/logout');
        $link->Content = __('logout');
        $link->setClass('tw-block tw-px-4 tw-py-2 tw-text-sm tw-text-gray-700 dark:tw-text-gray-200 hover:tw-bg-gray-100 dark:hover:tw-bg-gray-700');
        $box->add($link);
        $wrap->add($box);
        return $wrap;
    } else if (igk_environment()->isDev()){
        $auth = igk_create_node('div.autolog');
        $auth->a('@/autolog')->content = 'AutoLog';
    }
}
function themeToggleButton()
{
    $btn = igk_create_node('button');
    $btn->setClass('igk-winui-toggle-theme tw-px-3 tw-py-2 tw-rounded-lg tw-bg-gray-200 dark:tw-bg-gray-700 hover:tw-bg-gray-300 dark:hover:tw-bg-gray-600 tw-transition tw-text-sm tw-font-medium');
    $btn->id = 'theme-toggle';
    $btn->type = 'button';
    $btn->setAttribute('aria-label', 'Toggle dark mode');
    $btn->Content = '🌙';
    return $btn;
}
$menu = _h('div.menu-host', $menu_l = _h('ul.menu.dispflex.flex-row.alignm'));
$nav = _h('nav.flex.flex-row', $menu, themeToggleButton(), viewAuth());
$t->add(_h(
    'header.dispflex.flex-row.flex-justify-sb',
     $h,    
     $nav
));
$ctrl->setEnvParam('header', (object)[
    'top' => $menu_l,
    'nav'=> $nav
]);
 