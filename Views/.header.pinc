<?php
// @author: C.A.D. BONDJE DOUE
// @file: .header.pinc
// @date: 20240904 08:59:55
use IGK\Helper\ViewHelper;
use IGK\System\Html\SVG\SvgRenderer;
use function igk_html_host as _h;

/**
 * @var mixed $doc
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $modules
 */
$resolver = IGKResourceUriResolver::getInstance();
$asset_dir = $ctrl->getDataDir() . '/assets';
$resolver->resolve($asset_dir);
$twlink = $doc->head->link();
$twlink['rel'] = 'stylesheet';
$twlink['href'] = $resolver->resolve($asset_dir. '/css/tailwind.css');

$modules->require('igk.ios.SfSymbols');
SvgRenderer::RegisterFolder($asset_dir.'/svg');
igk_google_addfont($doc, "Roboto");
$t->setClass("+google-Roboto fit overflow-y-a");
$img = _h('img', [$ctrl->getDataDir() . '/assets/img/logo.jpg'])->setSize(64, 64);
if ($fname == 'default') {
    $h = $img;
} else {
    $h = _h('a.dispflex.cursor-pointer', [$ctrl::uri('@/')], $img);
}
function viewAuth()
{
    $ctrl = ViewHelper::CurrentCtrl();
    if ($user = $ctrl->getUser()) {
        $wrap = igk_create_node('div');
        $wrap->setClass('relative group pad4 cursor-pointer');
        $wrap->add(_h('span', $user->model()->clLogin));

        $box = igk_create_node('div');
        $box->setClass('box hidden group-hover:block absolute right-0 top-full min-w-[8rem] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow z-10');
        $link = igk_create_node('a');
        $link['href'] = $ctrl::uri('@/logout');
        $link->Content = __('logout');
        $link->setClass('block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700');
        $box->add($link);

        $wrap->add($box);
        return $wrap;
    }
}
function themeToggleButton()
{
    $btn = igk_create_node('button');
    $btn->setClass('igk-winui-toggle-theme px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition text-sm font-medium');
    $btn->id = 'theme-toggle';
    $btn->type = 'button';
    $btn->setAttribute('aria-label', 'Toggle dark mode');
    $btn->Content = '🌙';
    return $btn;
}
$nav = _h('nav.flex.flex-row', themeToggleButton(), viewAuth());
$menu = _h('nav.menu-host', $menu_l = _h('ul.menu.dispflex.flex-row.alignm'));
$t->add(_h(
    'header.dispflex.flex-row.flex-justify-sb',
    $h,
    $menu,
    $nav
));
$ctrl->setEnvParam('header', (object)['top' => $menu_l]);