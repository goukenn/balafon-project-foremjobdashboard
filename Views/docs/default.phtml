<?php
/**
 *  @var mixed $t
 * */
use com\igkdev\projects\ForemJobDashboard\JobDocTypes;
use com\igkdev\projects\ForemJobDashboard\Models\JobDocs;
use com\igkdev\projects\ForemJobDashboard\Models\JobDoctypes as ModelDocTypes;
use com\igkdev\projects\ForemJobDashboard\System\IO\FileViewer;
use IGK\Helper\IO; 
use function igk_html_host as _h;
use function igk_resources_getsf as __;

$def['.ft-s-4'] = 'font-size: 0.687em';
$error = [];
if ($request->method('POST') && $_FILES){
    $file = (object)igk_getv($_FILES, 'doc');
    $uid = '';
    $outdir = $ctrl->getDeclaredDir().'/Data/docs';
    IO::CreateDir($outdir);
    if (!($c = igk_io_move_uploaded_file($file->tmp_name, $outdir.'/'.$file->name))){
        $error[] = 'move uploaded file failed';
    } else{
        igk_navto($ruri);
    }
}
$job = $data->job;
$doc->title = $job ? $job->title .'\'s Document': 'Manages documents';
$_title =  $job ? _h('div > h1 > a.igk-btn[href:'.$ctrl::uri('@/jobs/edit/'.$job->id).']', $job->title) : null;
$t->main()->container()->div()->bind(
    $_title
);
if($docs = $data->documents){ 
    $c = count($docs);
    _h($t->section()->container()->singleRowCol()->div(), _h('p', sprintf(
        ($c>1)? 'document %s': 'documents %s',
        $c)));
    function render_doc($node, JobDocs $jobDocument, $ctrl){
        $r = json_decode($jobDocument->value);
        if ($r->type == 'template'){
            $node->h2()->content = $jobDocument->typeName() ?? 'template-motivation';
            _h($node, _h('pre.preserve.ft-s-4.overflow-a', $r->content ));
        } else { 
            $dd =ModelDocTypes::GetCache($jobDocument->job_doc_type_id);
            $node->li()->content = "Type: ".igk_getv($dd, 'name');
            $node->li()->content = $r->type;
            try{
                if ($viewer = FileViewer::CreateFromType($r->type)){
                    $viewer->view($node, $r, $ctrl);
                }
            }
            catch(\Exception $ex){  
            }
        }
        _h($node, _h('ajxa[method:post]', [$ctrl::uri('@/docs/drop/'.$jobDocument->id.';render=web')], 
            'remove document',
        ));
    }
    $container = $t->section()->container();
    $box = $container->div()->setClass('dispflex.flex-column');
    foreach($data->documents as $n){
        render_doc($box->div(), $n, $ctrl);
    }
}
if (isset($error) && $error){
    $t->add(_h('p.danger', $error));
}
if ($action_node = $ctrl::actionKey($action)){
    $t->add(_h('div.teleport.action-host', _h('notifyhost', [$action_node])));
}