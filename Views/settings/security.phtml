<?php
// @author: C.A.D. BONDJE DOUE
// @file: settings/security.phtml
// @desc: two-factor authentication (TOTP) enrollment/disable, styled with Tailwind CSS.
//        POST sub-actions (twofa_generate/twofa_enable/twofa_disable) are dispatched here via
//        igk_view_handle_actions(), not via SettingsAction's own *_post() URL-naming convention
//        — see CLAUDE.md ("Route:: gotchas for non-MiddlewireActionBase actions") for why plain
//        ActionBase POST dispatch on nested paths isn't reliable in this framework and this is
//        the pattern the rest of the module (Views/jobs/edit.phtml, add.phtml) already uses.
// @view: settings/security
// @date: 20260825 00:00:00
use com\igkdev\projects\ForemJobDashboard\Actions\SettingsAction;
use IGK\System\Http\Request;
use function igk_html_host as _h;
use function igk_resources_gets as __;

/**
 * @var mixed $t
 * @var mixed $ctrl
 * @var mixed $data
 * @var string $fname
 * @var mixed $params
 */

igk_view_handle_actions($fname, [
    'twofa_generate' => function () use ($ctrl, $fname) {
        SettingsAction::CreateInstance($ctrl)->twofa_generate_post();
        igk_navto($ctrl::uri($fname));
    },
    'twofa_enable' => function () use ($ctrl, $fname) {
        SettingsAction::CreateInstance($ctrl)->twofa_enable_post(Request::getInstance());
        igk_navto($ctrl::uri($fname));
    },
    'twofa_disable' => function () use ($ctrl, $fname) {
        SettingsAction::CreateInstance($ctrl)->twofa_disable_post();
        igk_navto($ctrl::uri($fname));
    },
], $params);

$doc->title = sprintf('%s - %s', __('Security'), $ctrl->getAppTitle());

$wrap = $t->div()->setClass('tw-max-w-lg tw-mx-auto tw-p-6');
$wrap->h2()->setClass('tw-text-xl tw-font-bold tw-mb-4')->Content = __('Two-factor authentication');

if (!empty($data->error)) {
    $wrap->div()->setClass('tw-bg-red-50 dark:tw-bg-red-900/40 tw-border tw-border-red-200 dark:tw-border-red-800 tw-text-red-700 dark:tw-text-red-300 tw-text-sm tw-rounded-lg tw-px-4 tw-py-3 tw-mb-4')
        ->Content = $data->error;
}
if (!empty($data->success)) {
    $wrap->div()->setClass('tw-bg-green-50 dark:tw-bg-green-900/40 tw-border tw-border-green-200 dark:tw-border-green-800 tw-text-green-700 dark:tw-text-green-300 tw-text-sm tw-rounded-lg tw-px-4 tw-py-3 tw-mb-4')
        ->Content = $data->success;
}

if ($data->twofa_enabled) {
    $wrap->p()->setClass('tw-text-gray-600 dark:tw-text-gray-300 tw-mb-4')->Content = __('Two-factor authentication is enabled on your account.');
    $form = $wrap->form();
    $form->setAttributes(['method' => 'POST', 'action' => $ctrl::uri($fname . '/twofa_disable')]);
    $form->button()->setAttributes(['type' => 'submit'])
        ->setClass('tw-bg-red-600 hover:tw-bg-red-700 tw-text-white tw-font-semibold tw-px-4 tw-py-2 tw-rounded-lg tw-transition')
        ->Content = __('Disable two-factor authentication');
} elseif ($data->twofa_pending_secret) {
    $wrap->p()->setClass('tw-text-gray-600 dark:tw-text-gray-300 tw-mb-4')->Content = __('Scan this QR code with your authenticator app, then enter the 6-digit code to confirm.');
    if ($data->twofa_pending_qr) {
        $wrap->img()->setAttribute('src', $data->twofa_pending_qr)->setClass('tw-mb-4');
    } else {
        $wrap->p()->setClass('tw-font-mono tw-text-sm tw-break-all tw-mb-4')->Content = $data->twofa_pending_uri;
    }
    $wrap->p()->setClass('tw-font-mono tw-text-sm tw-mb-4')->Content = $data->twofa_pending_secret;
    $form = $wrap->form();
    $form->setAttributes(['method' => 'POST', 'action' => $ctrl::uri($fname . '/twofa_enable')]);
    $form->setClass('tw-space-y-4');
    $field = $form->div();
    $field->label()->setClass('tw-block tw-text-sm tw-font-medium tw-mb-1')->Content = __('6-digit code');
    $field->input()->setAttributes([
        'type' => 'text',
        'name' => 'code',
        'inputmode' => 'numeric',
        'pattern' => '[0-9]{6}',
        'required' => 'required',
        'autocomplete' => 'one-time-code',
        'autofocus' => 'autofocus',
    ])->setClass('tw-w-full tw-rounded-lg tw-border tw-border-gray-300 dark:tw-border-gray-600 tw-bg-white dark:tw-bg-gray-700 tw-px-3 tw-py-2');
    $form->button()->setAttributes(['type' => 'submit'])
        ->setClass('tw-bg-blue-600 hover:tw-bg-blue-700 tw-text-white tw-font-semibold tw-px-4 tw-py-2 tw-rounded-lg tw-transition')
        ->Content = __('Confirm');
} else {
    $wrap->p()->setClass('tw-text-gray-600 dark:tw-text-gray-300 tw-mb-4')->Content = __('Two-factor authentication is not enabled on your account.');
    $form = $wrap->form();
    $form->setAttributes(['method' => 'POST', 'action' => $ctrl::uri($fname . '/twofa_generate')]);
    $form->button()->setAttributes(['type' => 'submit'])
        ->setClass('tw-bg-blue-600 hover:tw-bg-blue-700 tw-text-white tw-font-semibold tw-px-4 tw-py-2 tw-rounded-lg tw-transition')
        ->Content = __('Enable two-factor authentication');
}
