use function igk_resources_gets as __;

$enterprise = $data->enterprise;
$doc->title = sprintf('%s - details', $enterprise->name);
$row = $t->main()->container()->row();
$col = $row->col();
$col->div('h3')->Content = $enterprise->name;
if ($enterprise->title) {
    $col->div()->Content = $enterprise->title;
}
$dl = $col->dl();
if ($enterprise->vat) {
    $dl->dt()->Content = ucfirst(__('vat'));
    $dl->dd()->Content = $enterprise->vat;
}
if ($enterprise->address) {
    $dl->dt()->Content = ucfirst(__('address'));
    $dl->dd()->Content = $enterprise->address;
}
if ($enterprise->locality) {
    $dl->dt()->Content = ucfirst(__('locality'));
    $dl->dd()->Content = $enterprise->locality;
}
if ($enterprise->share_capital !== null) {
    $dl->dt()->Content = ucfirst(__('share_capital'));
    $dl->dd()->Content = $enterprise->share_capital;
}
if ($enterprise->turnover !== null) {
    $dl->dt()->Content = ucfirst(__('turnover'));
    $dl->dd()->Content = $enterprise->turnover;
}
foreach (['legal_form', 'phone', 'email', 'website', 'start_date', 'kbo_status'] as $k) {
    if ($enterprise->$k) {
        $dl->dt()->Content = ucfirst(__($k));
        $dl->dd()->Content = $enterprise->$k;
    }
}
if ($enterprise->kbo_fetched_at) {
    $col->div()->setClass('tw-text-xs tw-text-gray-500 dark:tw-text-gray-400')->Content =
        __('Source: BCE/KBO public search (SPF Economie)') . ' - ' . $enterprise->kbo_fetched_at;
}
if ($enterprise->description) {
    $col->div()->Content = $enterprise->description;
}
$col->div()->a($ctrl::uri('@/enterprise/edit/' . $enterprise->id))->Content = __('edit');
