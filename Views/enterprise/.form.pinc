<?php
// @desc: enterprise form (cards, dark/light) shared by enterprise/add.phtml and enterprise/edit.phtml
// expects: $page (node), $ctrl, $fname, $tw, $btn, $btn_main, $input, $card_cls,
//          $enterprise (?model, null when adding), $cancel_href, $submit_label
use function igk_resources_gets as __;

$form = $tw($page->form(), 'tw-flex tw-flex-col tw-gap-4');
$form['method'] = 'post';
$form['action'] = $ctrl::uri($fname);

// one labelled control; $attr are extra input attributes
$field = function ($parent, string $name, string $type = 'text', array $attr = [], bool $wide = false) use ($tw, $input, $enterprise) {
    $l = $tw($parent->label(), 'tw-flex tw-flex-col tw-gap-1 tw-text-sm tw-font-medium tw-text-gray-700 dark:tw-text-gray-300' . ($wide ? ' md:tw-col-span-2' : ''));
    $l->span(__('enterprise.field.' . $name));
    $value = $enterprise ? (string)($enterprise->$name ?? '') : '';
    if ($type === 'textarea') {
        $c = $tw($l->textarea(), $input);
        $c['name'] = $name;
        $c['rows'] = 3;
        $c['style'] = 'height:6rem;resize:vertical';
        $c->Content = $value;
    } else {
        $c = $tw($l->input($name, $type, $value), $input);
    }
    foreach ($attr as $k => $a) {
        $c[$k] = $a;
    }
    return $c;
};
$section = function (string $label) use ($form, $tw, $card_cls) {
    $card = $tw($form->div(), $card_cls);
    $tw($card->h3(), 'tw-text-lg tw-font-semibold tw-m-0')->Content = $label;
    return $tw($card->div(), 'tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-3');
};

// + | identity (the KBO button fills these fields)
$g = $section(__('enterprise.section.identity'));
$field($g, 'name', 'text', ['required' => 'required']);
$field($g, 'vat');
$field($g, 'title', 'text', [], true);
$field($g, 'description', 'textarea', ['maxlength' => 255], true);
$frm = $tw($g->div(), 'md:tw-col-span-2');
include __DIR__ . '/.kbo.pinc';

// + | contact
$g = $section(__('enterprise.section.contact'));
$field($g, 'address', 'text', [], true);
$field($g, 'locality');
$field($g, 'phone');
$field($g, 'email', 'email');
$field($g, 'website');

// + | company
$g = $section(__('enterprise.section.company'));
$field($g, 'legal_form');
$field($g, 'start_date', 'date');
$field($g, 'share_capital', 'number', ['step' => '0.01']);
$field($g, 'turnover', 'number', ['step' => '0.01']);
$field($g, 'kbo_status', 'text', ['readonly' => 'readonly', 'class' => $input . ' tw-opacity-70']);

// + | actions
$tw($bar = $form->div(), 'tw-flex tw-gap-2');
$b = $tw($bar->button(), $btn_main);
$b['type'] = 'submit';
$b->Content = $submit_label;
$c = $tw($bar->a(), $btn);
$c['href'] = $cancel_href;
$c->Content = __('Cancel');
