use com\igkdev\projects\ForemJobDashboard\Models\JobEnterprises;
use com\igkdev\projects\ForemJobDashboard\Models\Jobs;

use function igk_html_host as _h;
use function igk_resources_gets as __;

/**
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $data
 */
$form = _h('form#search-form');
$result = (function ($s)use($ctrl) {
    if ($o =  $s ? _h('p.result') : null) {
        foreach ($s as $p) {
            $o->li()->span()->a($ctrl::uri('@/enterprise/details/'.$p->{JobEnterprises::FD_ID}))->content = $p->{JobEnterprises::FD_NAME};
        }
    }
    return $o;
})($data->enterprises);
$form->fields([
    'enterprise' => '',
    '-'
]);
_h($t, _h(
    'main',
    _h('container > row', $form),
    _h('container > row', _h('a', [$ctrl::uri('@/enterprise/add')], __('Add enterprise'))),
    $result ? _h('container > row', $result ?: __('No result found')) : null
));