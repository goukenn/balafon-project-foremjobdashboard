<?php
// @author: C.A.D. BONDJE DOUE
// @file: enterprise/add.phtml
// @desc: add enterprise form, same charter as enterprise/edit.phtml (Tailwind cards, dark/light)
// @view: enterprise/add
use function igk_resources_gets as __;

/**
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $data
 */
$doc->title = __('Add enterprise');

// setClass() mangles '/' and ':' in class names (tw-bg-red-500/15, dark:...), so set the attribute directly
$tw = function ($node, string $classes) {
    $node['class'] = $classes;
    return $node;
};
$btn = 'tw-px-4 tw-py-2 tw-rounded-lg tw-text-sm tw-font-medium tw-no-underline tw-cursor-pointer tw-border tw-border-gray-300 dark:tw-border-gray-700 tw-bg-white dark:tw-bg-gray-900 tw-text-gray-800 dark:tw-text-gray-200 hover:tw-bg-gray-100 dark:hover:tw-bg-gray-800';
$btn_main = 'tw-px-4 tw-py-2 tw-rounded-lg tw-bg-blue-600 hover:tw-bg-blue-700 tw-text-white tw-text-sm tw-font-medium tw-no-underline tw-cursor-pointer tw-border-0';
$input = 'tw-w-full tw-px-3 tw-py-2 tw-rounded-lg tw-border tw-border-gray-300 dark:tw-border-gray-700 tw-bg-white dark:tw-bg-gray-900 tw-text-gray-900 dark:tw-text-gray-100';
$card_cls = 'tw-flex tw-flex-col tw-gap-3 tw-p-4 tw-rounded-xl tw-border tw-border-gray-200 dark:tw-border-gray-800 tw-bg-white dark:tw-bg-gray-900';

$page = $tw($t->div(), 'tw-flex tw-flex-col tw-gap-4 tw-pb-8 tw-w-full tw-max-w-4xl tw-mx-auto tw-px-4 tw-pt-6');
$enterprise = null;
$cancel_href = $ctrl::uri('@/enterprise');
$submit_label = __('add');

// + | header
$tw($head = $page->div(), 'tw-flex tw-flex-row tw-items-center tw-justify-between tw-gap-3');
$tw($head->h2(), 'tw-text-2xl tw-font-bold tw-m-0')->Content = __('Add enterprise');
$back = $tw($head->a(), $btn);
$back['href'] = $cancel_href;
$back->Content = __('Cancel');

if ($data->errors ?? null) {
    $w = $tw($page->div(), 'tw-p-3 tw-rounded-lg tw-border tw-border-red-400 tw-bg-red-50 dark:tw-bg-red-900 tw-text-red-900 dark:tw-text-red-100 tw-text-sm');
    $w['role'] = 'alert';
    $w->Content = __('The enterprise name is required.');
}
include __DIR__ . '/.form.pinc';
