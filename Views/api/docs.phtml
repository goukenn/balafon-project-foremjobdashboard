    'swagger.oauth' => function (Request $request) {
        // + | handle passing auth 
        $v_r_type = $request->get("response_type");
        if ( $v_r_type == 'code') {
            list($code_challenge, $code_challenge_method, $client_id, $redirect_uri, $state) = igk_extract(
                (object)$_REQUEST,
                'code_challenge|code_challenge_method|client_id|redirect_uri|state'
            );
            $is_pkce = $code_challenge && $code_challenge_method;
            if ($is_pkce) {
                $v_rep = SwaggerAccess::AuthorizeWithPKCE($client_id, $code_challenge, $code_challenge_method, $redirect_uri, $state);
                if ($v_rep) {
                    igk_navto(sprintf('%s?%s', $redirect_uri, http_build_query(array_merge(
                        $v_rep->data ?? [],
                        [
                            'state' => $state
                        ]
                    ))));
                    igk_exit();
                }
                igk_do_response(new JsonResponse([], StatusCode::UNAUTHORIZED));
            } 
        } 
        // token - client_id - token
        $ob = (object)$_REQUEST;
        SwaggerOAuth::HandleData($ob); 
    },
    'swagger.token' => function (Request $request) {
        // + | 
        // + | retreive token - token 
        // + |
        $data = null;
        $ctrl = ViewHelper::CurrentCtrl();
        $user = Users::currentUser();
        if (igk_server()->isURLEncoded()) {
            $data = $request->getFormData();
        } else {
            $data = $request->getJsonData();
        }
        list($grant_type, $scope, $username, $password) = igk_extract($data, 'grant_type|scope|username|password');
        $response = null;
        switch ($grant_type) {
            case 'password':
                $response = SwaggerAccess::Login($username, $password, $ctrl, $user, $scope); 
                break;
            case 'authorization_code':
                // handle authorization code
                list($scope, $code, $username, $password, $code_verifier) = igk_extract($data, 'scope|code|client_id|client_secret|code_verifier');
                $response = SwaggerAccess::PKCELoginAndTokenResponse($username,  $password, $code, $code_verifier, $scope,
                $ctrl, $user);
                break;
            case 'client_credentials':
                // bearer auth container login:password in base64 encoding format
                $access = igk_server()->getAccessObject();
                $token = $access->getBasicToken();
                list($login, $pwd) = explode(':', base64_decode($token));
                $login = trim($login);
                $pwd = trim($pwd);
                $response = SwaggerAccess::Login($login, $pwd, $ctrl, $user, $scope);
                break;
        }
        igk_do_response($response ?? new JsonResponse(["error" => 401], 401));
    }
], $params);
