<?php
// @author: C.A.D. BONDJE DOUE
// @file: login/2fa.phtml
// @desc: 2FA code entry step, shown after a successful password check when the account has
//        two-factor authentication enabled.
// @view: login/2fa
// @date: 20260825 00:00:00

use function igk_resources_gets as __;

/**
 * @var mixed $t
 * @var IGKHtmldoc $doc
 * @var mixed $ctrl
 * @var mixed $data
 */

$doc->title = __('Verify your identity');
$t->clearChilds();

$main = $t->main()->setClass("tw-min-h-screen tw-bg-gray-50 dark:tw-bg-gray-900 tw-flex tw-items-center tw-justify-center tw-px-4 tw-transition-colors tw-duration-300");

$card = $main->div()->setClass("tw-w-full tw-max-w-md tw-bg-white dark:tw-bg-gray-800 tw-rounded-lg tw-shadow tw-p-8 tw-relative tw-transition-colors tw-duration-300");

$themeBtn = $card->button();
$themeBtn->setClass("igk-winui-toggle-theme tw-absolute tw-top-4 tw-right-4 tw-px-3 tw-py-2 tw-rounded-lg tw-bg-gray-200 dark:tw-bg-gray-700 hover:tw-bg-gray-300 dark:hover:tw-bg-gray-600 tw-transition tw-text-sm tw-font-medium");
$themeBtn->id = "theme-toggle";
$themeBtn->type = "button";
$themeBtn->setAttribute("aria-label", "Toggle dark mode");

$card->h1()->setClass("tw-text-2xl tw-font-bold tw-text-gray-900 dark:tw-text-white tw-mb-1")->Content = __('Verify your identity');
$card->p()->setClass("tw-text-gray-500 dark:tw-text-gray-400 tw-mb-6")->Content = __('Enter the 6-digit code from your authenticator app.');

if (!empty($data->error)) {
    $card->div()->setClass("tw-bg-red-50 dark:tw-bg-red-900/40 tw-border tw-border-red-200 dark:tw-border-red-800 tw-text-red-700 dark:tw-text-red-300 tw-text-sm tw-rounded-lg tw-px-4 tw-py-3 tw-mb-6")
        ->Content = $data->error;
}

$form = $card->form();
$form->setAttributes(['method' => 'POST', 'action' => $ctrl::uri('@/login/login2fa')]);
$form->setClass("tw-space-y-4");
$form->input()->setAttributes(['type' => 'hidden', 'name' => 'redirect', 'value' => $data->redirect ?? $ctrl::uri('@/')]);

$codeField = $form->div();
$codeField->label()->setClass("tw-block tw-text-sm tw-font-medium tw-text-gray-700 dark:tw-text-gray-300 tw-mb-1")->Content = __('6-digit code');
$codeField->input()->setAttributes([
    'type' => 'text',
    'name' => 'code',
    'inputmode' => 'numeric',
    'pattern' => '[0-9]{6}',
    'required' => 'required',
    'autocomplete' => 'one-time-code',
    'autofocus' => 'autofocus',
])->setClass("tw-w-full tw-rounded-lg tw-border tw-border-gray-300 dark:tw-border-gray-600 tw-bg-white dark:tw-bg-gray-700 tw-text-gray-900 dark:tw-text-white tw-px-3 tw-py-2 focus:tw-outline-none focus:tw-ring-2 focus:tw-ring-blue-600");

$form->button()->setAttributes(['type' => 'submit'])
    ->setClass("tw-w-full tw-bg-blue-600 hover:tw-bg-blue-700 tw-text-white tw-font-semibold tw-py-2.5 tw-rounded-lg tw-transition")
    ->Content = __('Verify');
