use function igk_resources_gets as __;
use IGK\System\Html\Css\CssUtils;
use IGK\System\Html\Dom\HtmlDocTheme;
/**
 * footer 
 * @var mixed $t
 * @var HtmlDocTheme $def
 * @var ForemJobDashboardController $ctrl
 */


$footer = $t->footer()->container()->row();
$c = $footer->col();
$c->igkcopyright();
$c->label()->content = ('v - '.$ctrl::version);
$legal = $footer->col()->nav()->setClass('legal-links');
$legal->a()->setAttributes(['href' => $ctrl::uri('@/terms')])->Content = __('Terms of use');
$legal->a()->setAttributes(['href' => $ctrl::uri('@/privacy')])->Content = __('Privacy');


$def['.dispsticky'] = '{sys:dispsticky}';
$def['.dispb'] = '{sys:dispb}';
$def['.dispn'] = '{sys:dispn}';
$def['main'] = 'flex-grow: 1;';
$t['class']='+fit flex flex-column';

$def::ImportSystemDefinition($def, ['igk-container', 'no-wrap','no-shrink', 'ellipsis', 'no-overflow', 'grow-1']);