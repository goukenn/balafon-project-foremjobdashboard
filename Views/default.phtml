/**
 * @var mixed $t
 */
use IGK\Helper\ViewHelper;
use IGK\System\Html\Dom\HtmlItemBase;
use IGK\System\Html\Dom\HtmlNode;
use IGK\System\IO\Path;
use com\igkdev\projects\ForemJobDashboard\System\WinUI\PageContainer;
use function igk_html_host as _h;
use function igk_resources_gets as __;

/**
 * @var mixed $ctrl
 * @var mixed $t
 * @var mixed $doc
 */
$this->checkUser(false);
$pagecontainer = new PageContainer;
$pagecontainer->panel()->setContent(__('Dashboard list'));

function get_pageview($ctrl)
{
    $tab = [];
    return $tab;
}
_h(
    $ctrl->getEnvParam('header')->top,    
    $pagecontainer,
    ...get_pageview($ctrl)
);
// $layout->import('#.menu.pinc');

$menus = include(ViewHelper::Dir() . '/.menu.pinc');
if (!($profile = $ctrl->getUserProfile())) {
}
$list = igk_create_node_arg("ul.dispflex.flex-row.gap-4.alignr.no-wrap.ellipsis.no-shrink");
foreach ($menus as $k => $v) {
    $a = $list->li()->a($ctrl::uri($v));
    $a->setContent($k);
}
_h($ctrl->getEnvParam('header')->top, $list);
$t['class'] = '+dispflex +flex-column -fit';
$t['style'] = 'min-height:100%;';
_h(
    $t->section()->container()->nav()
        ->setStyle('height: 2em')
        ->setClass('menu dispflex flex-row no-wrap gap-10 flex-end flex-cross-start'),        
        $profile ? null :
        _h(
            'div.sign-or-register.dispflex.flex-row.flex-item-start',
            _h('abtn.sign', [$ctrl::uri('@/login')], 'SignIn'),
            _h('abtn.register', [$ctrl::uri('@/sign/register')], 'Register')
        )
);
// + | ------------------------------------------------
// + | landing page: hero, quick access, search engines, interims, tools
// + |
$home = $t->add(_h('section.fjd-home'));
$wrap = $home->div()->setClass('fjd-wrap');

$hero = $wrap->div()->setClass('fjd-hero');
$hero->p()->setClass('fjd-eyebrow')->Content = __('Job search workflow');
$hero->h1()->Content = $ctrl->getConfigs()->clTitle ?? 'Forem Jobs Dashboard';
$hero->p()->setClass('fjd-lead')->Content = __('Track offers, applications, enterprises and documents in one place.');
$cta = $hero->div()->setClass('fjd-cta');
if ($profile) {
    $cta->a()->setAttributes(['href' => $ctrl::uri('@/jobs'), 'class' => 'fjd-btn fjd-btn-primary'])->Content = __('jobs');
    $cta->a()->setAttributes(['href' => $ctrl::uri('@/jobs/add'), 'class' => 'fjd-btn'])->Content = __('add');
} else {
    $cta->a()->setAttributes(['href' => $ctrl::uri('@/login'), 'class' => 'fjd-btn fjd-btn-primary'])->Content = __('SignIn');
}

if (!empty($data->stats)) {
    $stats = $wrap->div()->setClass('fjd-stats');
    foreach ($data->stats as $label => $value) {
        $st = $stats->div()->setClass('fjd-stat');
        $st->span()->setClass('fjd-stat-value')->Content = (string)$value;
        $st->span()->setClass('fjd-stat-label')->Content = __($label);
    }
}

$icons = [
    'jobs' => '💼', 'update' => '🔄', 'exports' => '📤', 'zip' => '🗜️', 'motivation' => '✉️',
    'cv' => '📄', 'enterprises' => '🏢', 'print-report' => '🖨️', 'about' => 'ℹ️',
];
$block = $wrap->div()->setClass('fjd-block');
$block->h2()->Content = __('Quick access');
$grid = $block->div()->setClass('fjd-grid fjd-grid-menu');
foreach (include(ViewHelper::Dir() . '/.menu.all.pinc') as $k => $v) {
    if ($k == 'home') {
        continue;
    }
    $card = $grid->a()->setAttributes(['href' => $ctrl::uri($v), 'class' => 'fjd-card fjd-card-link']);
    $card->span()->setClass('fjd-icon')->Content = $icons[$k] ?? '•';
    $card->span()->setClass('fjd-card-title')->Content = __($k);
}

if ($r = $data->job_search_engines ?? []) {
    $block = $wrap->div()->setClass('fjd-block');
    $block->h2()->Content = __('Jobs search Engines');
    $chips = $block->div()->setClass('fjd-chips');
    foreach ($r as $e) {
        $chips->a()->setAttributes([
            'href' => $e->url, 'target' => '_blank', 'rel' => 'noopener noreferrer', 'class' => 'fjd-chip'
        ])->Content = $e->name;
    }
}

if ($r = $data->interims ?? []) {
    $block = $wrap->div()->setClass('fjd-block');
    $block->h2()->Content = __('interims');
    $p = $block->p()->setClass('fjd-muted');
    $p->Content = __('retrieve all available interims at ');
    $p->a()->setAttributes(['href' => 'https://federgon.be', 'target' => '_blank', 'rel' => 'noopener noreferrer'])->Content = 'federgon';
    $grid = $block->div()->setClass('fjd-grid fjd-grid-interims');
    foreach ($r as $e) {
        $card = $grid->a()->setAttributes([
            'href' => $e->url, 'target' => '_blank', 'rel' => 'noopener noreferrer', 'class' => 'fjd-card fjd-card-link fjd-interim'
        ]);
        $img = $card->img();
        $img['src'] = $e->picture ?? Path::Combine($e->url, "favicon.ico");
        $img['alt'] = '';
        $img['width'] = $img['height'] = '32';
        $img['loading'] = 'lazy';
        $img['onerror'] = "this.style.visibility='hidden'";
        $card->span()->setClass('fjd-card-title')->Content = $e->name;
    }
}

$v_rtools = $data->job_tools ?? [
    (object)[
        'title' => 'CV Maker',
        'desc' => 'Online CV Maker descriptions',
        'uri' => 'https://cv.adecco.be/fr/generator?utm_source=MyAdecco&utm_medium=Page4',
    ],
    (object)[
        'title' => 'ChatGPT-AI',
        'desc' => 'AI chat GPTss',
        'uri' => 'https://chatgpt.com',
    ],
];
$block = $wrap->div()->setClass('fjd-block');
$block->h2()->Content = __('Tools');
$block->p()->setClass('fjd-muted')->Content = __('Tools In Used');
$grid = $block->div()->setClass('fjd-grid fjd-grid-tools');
foreach ($v_rtools as $row) {
    $card = $grid->div()->setClass('fjd-card');
    $card->h3()->setClass('fjd-card-title')->Content = $row->title;
    $card->p()->setClass('fjd-muted')->Content = $row->desc;
    if (isset($row->uri)) {
        $card->a()->setAttributes([
            'href' => $row->uri, 'target' => '_blank', 'rel' => 'noopener noreferrer', 'class' => 'fjd-btn fjd-btn-small'
        ])->Content = __('Open') . ' · ' . preg_replace('/^www\./i', '', (string)parse_url($row->uri, PHP_URL_HOST));
    }
}
